{
  "name": "@leximon/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database schema, migrations and client.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./catalog": "./src/catalog/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:integration": "vitest run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "catalog:publish": "node --env-file-if-exists=../../.env --import ../config/node/resolve-ts.mjs scripts/publish-catalog.ts",
    "reserve:publish": "node --env-file-if-exists=../../.env --import ../config/node/resolve-ts.mjs scripts/publish-reserve.ts",
    "finds:export": "node --env-file-if-exists=../../.env --import ../config/node/resolve-ts.mjs scripts/finds.ts export",
    "finds:reject": "node --env-file-if-exists=../../.env --import ../config/node/resolve-ts.mjs scripts/finds.ts reject",
    "admin:grant": "node --env-file-if-exists=../../.env --import ../config/node/resolve-ts.mjs scripts/grant-admin.ts",
    "dev:player": "node --env-file-if-exists=../../.env --import ../config/node/resolve-ts.mjs scripts/dev-player.ts",
    "economy:snapshot": "node --env-file-if-exists=../../.env --import ../config/node/resolve-ts.mjs scripts/economy-snapshot.ts",
    "load:players": "node --import ../config/node/resolve-ts.mjs scripts/load-players.ts"
  },
  "dependencies": {
    "@leximon/contract": "workspace:*",
    "@leximon/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@leximon/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
