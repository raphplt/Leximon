# Copy to .env on the home server. Never commit .env. Restrict it: chmod 600 .env
# Random secrets: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_SECRET=
# Token of the Cloudflare tunnel (Zero Trust > Networks > Tunnels > the tunnel > Docker).
TUNNEL_TOKEN=
# Folder where the database lives (ideally on the ZFS pool, outside the VM disk).
DATA_PATH=./data
# Port of the dashboard on this machine, reached through Tailscale.
DASHBOARD_PORT=3000
