# Copy to .env on the home server. Never commit .env. Restrict it: chmod 600 .env
# Random secrets: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_SECRET=
# Token of the Cloudflare tunnel (Zero Trust > Networks > Tunnels > the tunnel > Docker).
TUNNEL_TOKEN=
# Folder where the database lives. Keep it on the VM disk: Postgres is not safe on the virtiofs share.
DATA_PATH=./data
# Port of the dashboard on this machine only, served on the tailnet by `tailscale serve`.
DASHBOARD_PORT=3000
