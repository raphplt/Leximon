# Copy to .env on the NAS. Never commit .env.
# Direct connection to the home database, from the `docker` VM.
DATABASE_URL=postgresql://leximon_app:PASSWORD@192.168.0.53:5432/leximon?sslmode=require
# Folder of the NAS where dumps are written (a share that is itself backed up, ideally).
BACKUP_PATH=./dumps
# Days a dump is kept.
KEEP_DAYS=30
# Time of the nightly dump (Europe/Paris).
BACKUP_HOUR=4
BACKUP_MINUTE=30
