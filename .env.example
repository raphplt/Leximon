# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://leximon:leximon@127.0.0.1:54329/leximon
# Integration tests: wiped and migrated on every run. Must end with "_test".
TEST_DATABASE_URL=postgres://leximon:leximon@127.0.0.1:54329/leximon_test
# Content pipeline (local only)
ANTHROPIC_API_KEY=
# Google Cloud Text-to-Speech, for `prononciation-audio` (D-032). Restrict the key to that API.
GOOGLE_TTS_API_KEY=
# Directus, the content review tool: `docker compose --profile content up -d`
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_ADMIN_TOKEN=
DIRECTUS_URL=http://127.0.0.1:8055
