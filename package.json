{
  "name": "leximon",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && turbo run typecheck test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "db:migrate": "pnpm --filter @leximon/db db:migrate",
    "db:seed:dev": "docker compose exec -T postgres psql -U leximon -d leximon -v ON_ERROR_STOP=1 -f - < packages/db/seeds/dev-cards.sql"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
