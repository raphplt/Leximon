{
  "name": "leximon",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "services": "docker compose --profile content up -d --wait",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && turbo run typecheck test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "db:migrate": "pnpm --filter @leximon/db db:migrate",
    "catalog:publish": "pnpm --filter @leximon/db catalog:publish",
    "admin:grant": "pnpm --filter @leximon/db admin:grant",
    "dev:player": "pnpm --filter @leximon/db dev:player",
    "db:migrate:prod": "sh infra/prod/check-database-url.sh && pnpm db:migrate",
    "catalog:publish:prod": "sh infra/prod/check-database-url.sh && pnpm catalog:publish",
    "admin:grant:prod": "sh infra/prod/check-database-url.sh && pnpm admin:grant",
    "deploy:api": "pnpm --filter @leximon/api exec wrangler deploy --env production",
    "deploy:web": "pnpm --filter @leximon/web run deploy:production"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
