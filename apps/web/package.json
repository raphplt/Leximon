{
  "name": "@leximon/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:production": "test -f public/catalog/manifest.json || { echo 'No catalogue in public/catalog: run pnpm catalog:publish:prod first.' >&2; exit 1; } && NEXT_PUBLIC_API_URL=https://api.leximon.fr opennextjs-cloudflare build --env production && opennextjs-cloudflare deploy --env production",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@leximon/contract": "workspace:*",
    "@leximon/core": "workspace:*",
    "@leximon/tokens": "workspace:*",
    "@leximon/view-model": "workspace:*",
    "@opennextjs/cloudflare": "1.20.13",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@leximon/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.151.1"
  }
}
