# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Signs the unsubscribe links of campaigns and notifications. Generate with: openssl rand -hex 32
EMAIL_LINK_SECRET=
# Lettermint (campaigns, D-034). Empty in local development: campaigns go to the console.
LETTERMINT_SENDING_TOKEN=
LETTERMINT_WEBHOOK_SECRET=
# Morning summary on Discord, after the daily maintenance. Empty: no summary.
DISCORD_WEBHOOK_URL=
# Errors of the summary: account id and an API token with "Workers Observability" access.
CLOUDFLARE_ACCOUNT_ID=
OBSERVABILITY_TOKEN=
# Store reviewers' account: one address that signs in with a fixed 6-digit code, no e-mail sent.
# Empty: no such account. See docs/fiches-stores.md.
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_CODE=
# Signing in with Google: the "Leximon local" OAuth client of the Google console. Empty: no Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Patron subscription (D-059): the test mode keys of the Stripe dashboard, and the secret that
# `stripe listen --forward-to localhost:8787/stripe/webhook` prints. Empty: nothing is sold.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
