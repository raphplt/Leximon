{
  "name": "@leximon/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "dev:bots": "node --experimental-transform-types --no-warnings --env-file-if-exists=../../.env --import ../../packages/config/node/resolve-ts.mjs scripts/dev-bots.ts",
    "deploy": "wrangler deploy --env production",
    "cf-typegen": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.11",
    "@leximon/contract": "workspace:*",
    "@leximon/core": "workspace:*",
    "@leximon/db": "workspace:*",
    "@leximon/tokens": "workspace:*",
    "@leximon/view-model": "workspace:*",
    "better-auth": "1.7.11",
    "drizzle-orm": "catalog:",
    "hono": "4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@leximon/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.151.1"
  }
}
