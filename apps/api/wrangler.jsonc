{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leximon-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Runs the Worker next to the database, in Paris where the home server's tunnel lands: an open
  // makes several sequential database round trips.
  "placement": { "region": "aws:eu-west-3" },
  // Daily maintenance (partitions, purges) at 03:17 UTC. The campaign pump runs through the
  // campaign queue, only when needed. The watchdog checks the database and its backups every five
  // minutes: on a database that sleeps when idle, like Neon, it would burn the compute quota.
  // Evening reminders at 18:00 in Paris: 17:00 UTC in winter, 16:00 in summer. Each run checks the
  // hour in Paris first and the wrong one stops before touching the database.
  "triggers": { "crons": ["17 3 * * *", "0 16 * * *", "0 17 * * *", "*/5 * * * *"] },
  "vars": {
    "APP_ENV": "development",
    "BETTER_AUTH_URL": "http://localhost:8787",
    // Comma-separated origins allowed to call the API with credentials (web app).
    "TRUSTED_ORIGINS": "http://localhost:3000",
    // Sender of sign-in codes. Empty: no code is sent outside local development, where
    // the code is printed in the console instead.
    "EMAIL_CODE_FROM": "",
    "EMAIL_REPLY_TO": "contact@leximon.fr",
    // Sender of campaigns (Lettermint). Empty: campaigns are only printed in the console
    // in local development, and refused elsewhere.
    "EMAIL_CAMPAIGN_FROM": "",
    "LETTERMINT_BROADCAST_ROUTE": "broadcast",
    // Sender of notification e-mails (letters waiting, sachets full). Empty: they are only
    // printed in the console in local development, and never sent elsewhere.
    "EMAIL_NOTIFY_FROM": "",
    // Notification e-mails per day in Paris, all players together: keeps the provider's daily
    // quota for sign-in codes, which share it.
    "NOTIFY_DAILY_LIMIT": "200",
    // Web app, for the unsubscribe page linked from every campaign.
    "PUBLIC_WEB_URL": "http://localhost:3000",
    // "required": a new player needs an invitation code (closed beta). "off": anyone plays.
    "BETA_INVITES": "off",
    // Oldest mobile app version still served: raised when the API drops what an old app needs,
    // the app then asks to be updated.
    "MOBILE_MIN_VERSION": "0.0.0",
    "PATRON_SALES": "closed",
    // The patrons' Discord: the bot's application, the server, the role it gives. Empty: no
    // link offered. Secrets DISCORD_CLIENT_SECRET and DISCORD_BOT_TOKEN complete them.
    "DISCORD_CLIENT_ID": "1568981422721470464",
    "DISCORD_GUILD_ID": "1563157710042570764",
    "DISCORD_PATRON_ROLE_ID": "1569285444594573342"
  },
  // Campaign e-mails: the pump queues row ids, the consumer sends them in batches.
  // Game events: cards obtained and clan changes, recounted from the database.
  // `queue()` tells them apart by `batch.queue`.
  "queues": {
    "producers": [
      { "binding": "CAMPAIGN_QUEUE", "queue": "leximon-email-campaigns" },
      { "binding": "GAME_EVENTS", "queue": "leximon-game-events" }
    ],
    "consumers": [
      {
        "queue": "leximon-email-campaigns",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 4,
        "dead_letter_queue": "leximon-email-campaigns-dlq"
      },
      {
        "queue": "leximon-game-events",
        "max_batch_size": 50,
        "max_batch_timeout": 2,
        "max_retries": 3,
        // Left unset, consumers scale out with the backlog and each one recounts the same clans:
        // two at a time keep the database's load flat, and fuller batches fold more events.
        "max_concurrency": 2,
        "dead_letter_queue": "leximon-game-events-dlq"
      }
    ]
  },
  // Cloudflare Email Service: one binding per sender, which cannot send from any other address.
  // Notifications have their own subdomain, so that a complaint about them never touches the
  // reputation of sign-in codes. `wrangler dev` simulates both.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["code@mail.leximon.fr"]
    },
    {
      "name": "NOTIFY_EMAIL",
      "allowed_sender_addresses": ["facteur@avis.leximon.fr"]
    }
  ],
  // Counted per Cloudflare location. Namespace ids are unique per account: never reuse one.
  "ratelimits": [
    // Guest account creation, per IP. High enough for a classroom behind a single address.
    {
      "name": "SIGNUP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    // Authenticated requests, per player.
    {
      "name": "PLAYER_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    },
    // Sign-in codes sent, per IP: protects the sending reputation and the e-mail budget.
    {
      "name": "OTP_SEND_IP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    },
    // Sign-in codes sent, per address (keyed on a keyed hash, never the address): no mail bombing.
    {
      "name": "OTP_SEND_EMAIL_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 1, "period": 60 }
    },
    // Code checks (preview and sign-in), per IP. Each code also allows 3 wrong attempts only.
    {
      "name": "OTP_VERIFY_IP_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 }
    },
    // Waiting-list sign-ups, per IP. Nobody signs up a whole classroom from one address.
    {
      "name": "WAITLIST_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 10, "period": 60 }
    },
    // Public e-mail routes (unsubscribe), per IP.
    {
      "name": "EMAIL_LINK_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "kv_namespaces": [{ "binding": "WATCHDOG", "id": "2489775cf74c429a87fe03d407bc8d5e" }],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "leximon-backups", "jurisdiction": "eu" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder until the production Hyperdrive config is created.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://leximon:leximon@127.0.0.1:54329/leximon"
    }
  ],

  // Production: `pnpm deploy:api` (Worker `leximon-api-production`, on api.leximon.fr). The top
  // level above stays the local configuration and is never deployed. Wrangler does not inherit
  // vars and bindings into an environment: a binding added above must be copied here too.
  // Secrets (`wrangler secret put … --env production`): BETTER_AUTH_SECRET, EMAIL_LINK_SECRET,
  // LETTERMINT_SENDING_TOKEN, LETTERMINT_WEBHOOK_SECRET, and for the morning summary
  // DISCORD_WEBHOOK_URL, CLOUDFLARE_ACCOUNT_ID, OBSERVABILITY_TOKEN, and for the store reviewers
  // REVIEW_ACCOUNT_EMAIL, REVIEW_ACCOUNT_CODE, and for the patrons' Discord DISCORD_CLIENT_SECRET,
  // DISCORD_BOT_TOKEN. See docs/mise-en-ligne.md.
  "env": {
    "production": {
      "routes": [{ "pattern": "api.leximon.fr", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://api.leximon.fr",
        // The web app on its own subdomain: same site, so the session cookie (host-only on
        // api.leximon.fr, SameSite=Lax) goes with every `credentials: "include"` request.
        "TRUSTED_ORIGINS": "https://leximon.fr",
        "EMAIL_CODE_FROM": "Leximon <code@mail.leximon.fr>",
        "EMAIL_REPLY_TO": "contact@leximon.fr",
        // Campaigns stay refused until LETTERMINT_SENDING_TOKEN is set.
        "EMAIL_CAMPAIGN_FROM": "Leximon <bonjour@infos.leximon.fr>",
        "LETTERMINT_BROADCAST_ROUTE": "broadcast",
        "EMAIL_NOTIFY_FROM": "Leximon <facteur@avis.leximon.fr>",
        "NOTIFY_DAILY_LIMIT": "200",
        "PUBLIC_WEB_URL": "https://leximon.fr",
        "BETA_INVITES": "off",
        "MOBILE_MIN_VERSION": "0.0.0",
        // "open" sells the patron subscription; closed, only admins can buy, to try the payment.
        "PATRON_SALES": "closed",
        "DISCORD_CLIENT_ID": "1568981422721470464",
        "DISCORD_GUILD_ID": "1563157710042570764",
        "DISCORD_PATRON_ROLE_ID": "1569285444594573342"
      },
      // Same queue names as above: `queue()` recognises the game events queue by its name.
      "queues": {
        "producers": [
          { "binding": "CAMPAIGN_QUEUE", "queue": "leximon-email-campaigns" },
          { "binding": "GAME_EVENTS", "queue": "leximon-game-events" }
        ],
        "consumers": [
          {
            "queue": "leximon-email-campaigns",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 4,
            "dead_letter_queue": "leximon-email-campaigns-dlq"
          },
          {
            "queue": "leximon-game-events",
            "max_batch_size": 50,
            "max_batch_timeout": 2,
            "max_retries": 3,
            "max_concurrency": 2,
            "dead_letter_queue": "leximon-game-events-dlq"
          }
        ]
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["code@mail.leximon.fr"]
        },
        {
          "name": "NOTIFY_EMAIL",
          "allowed_sender_addresses": ["facteur@avis.leximon.fr"]
        }
      ],
      // Same limits and ids as above: the local ones are simulated and never reach the account.
      "ratelimits": [
        {
          "name": "SIGNUP_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "PLAYER_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "OTP_SEND_IP_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "OTP_SEND_EMAIL_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 1, "period": 60 }
        },
        {
          "name": "OTP_VERIFY_IP_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "WAITLIST_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "EMAIL_LINK_RATE_LIMITER",
          "namespace_id": "1007",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "kv_namespaces": [{ "binding": "WATCHDOG", "id": "2489775cf74c429a87fe03d407bc8d5e" }],
      "r2_buckets": [
        { "binding": "BACKUPS", "bucket_name": "leximon-backups", "jurisdiction": "eu" }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // leximon-db-nas, on the home server through Workers VPC, created with --caching-disabled:
          // a cached read could show a collection from before the pack just opened.
          "id": "217ed0d8d32b4184a7a3491884afe5db"
        }
      ]
    },

    // Load tests only (docs/rnd/charge.md): `wrangler deploy --env staging`, on workers.dev. A
    // Neon branch of its own, its own queues (the `-staging` suffix keeps its messages away from
    // the production consumers) and its own rate limit ids. No daily task: the branch sleeps
    // between two runs. Secrets: BETTER_AUTH_SECRET and EMAIL_LINK_SECRET, random, its own.
    "staging": {
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": [] },
      "vars": {
        "APP_ENV": "staging",
        "BETTER_AUTH_URL": "https://leximon-api-staging.raphael-plassart.workers.dev",
        // The Origin the load test sends; no browser ever calls this API.
        "TRUSTED_ORIGINS": "https://leximon.fr",
        // No sign-in code, campaign nor notification leaves staging.
        "EMAIL_CODE_FROM": "",
        "EMAIL_REPLY_TO": "contact@leximon.fr",
        "EMAIL_CAMPAIGN_FROM": "",
        "LETTERMINT_BROADCAST_ROUTE": "broadcast",
        "EMAIL_NOTIFY_FROM": "",
        "NOTIFY_DAILY_LIMIT": "0",
        "PUBLIC_WEB_URL": "https://leximon.fr",
        "BETA_INVITES": "off",
        "MOBILE_MIN_VERSION": "0.0.0",
        "PATRON_SALES": "closed",
        "DISCORD_CLIENT_ID": "1568981422721470464",
        "DISCORD_GUILD_ID": "1563157710042570764",
        "DISCORD_PATRON_ROLE_ID": "1569285444594573342"
      },
      "queues": {
        "producers": [
          { "binding": "CAMPAIGN_QUEUE", "queue": "leximon-email-campaigns-staging" },
          { "binding": "GAME_EVENTS", "queue": "leximon-game-events-staging" }
        ],
        "consumers": [
          {
            "queue": "leximon-email-campaigns-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 4,
            "dead_letter_queue": "leximon-email-campaigns-staging-dlq"
          },
          {
            "queue": "leximon-game-events-staging",
            "max_batch_size": 50,
            "max_batch_timeout": 2,
            "max_retries": 3,
            "max_concurrency": 2,
            "dead_letter_queue": "leximon-game-events-staging-dlq"
          }
        ]
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["code@mail.leximon.fr"]
        },
        {
          "name": "NOTIFY_EMAIL",
          "allowed_sender_addresses": ["facteur@avis.leximon.fr"]
        }
      ],
      // Same limits as production, except guest creation: the whole load comes from one address,
      // where a stream brings players from thousands.
      "ratelimits": [
        {
          "name": "SIGNUP_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 10000, "period": 60 }
        },
        {
          "name": "PLAYER_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "OTP_SEND_IP_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "OTP_SEND_EMAIL_RATE_LIMITER",
          "namespace_id": "2004",
          "simple": { "limit": 1, "period": 60 }
        },
        {
          "name": "OTP_VERIFY_IP_RATE_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "WAITLIST_RATE_LIMITER",
          "namespace_id": "2006",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "EMAIL_LINK_RATE_LIMITER",
          "namespace_id": "2007",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      // Frankfurt: staging stays on Neon, so that a load test never touches the production server.
      "placement": { "region": "aws:eu-central-1" },
      "kv_namespaces": [{ "binding": "WATCHDOG", "id": "2489775cf74c429a87fe03d407bc8d5e" }],
      "r2_buckets": [
        { "binding": "BACKUPS", "bucket_name": "leximon-backups", "jurisdiction": "eu" }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // leximon-db-staging, on the Neon branch `charge`, created with --caching-disabled.
          "id": "21dcf38e1f8142bf90e65d8ff1d2b9b9"
        }
      ]
    }
  }
}
