{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leximon-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Runs the Worker close to the database rather than close to the player: an open makes
  // several sequential database round trips, which would be slow from far away.
  "placement": { "mode": "smart" },
  // Daily maintenance (partitions, idempotency purge), at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "APP_ENV": "development",
    "BETTER_AUTH_URL": "http://localhost:8787",
    // Comma-separated origins allowed to call the API with credentials (web app).
    "TRUSTED_ORIGINS": "http://localhost:3000"
  },
  // Counted per Cloudflare location. Namespace ids are unique per account: never reuse one.
  "ratelimits": [
    // Guest account creation, per IP. High enough for a classroom behind a single address.
    {
      "name": "SIGNUP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    // Authenticated requests, per player.
    {
      "name": "PLAYER_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Event log of the A/B tests (D-030): the API only queues, the same Worker consumes in batches.
  "queues": {
    "producers": [{ "binding": "ANALYTICS_QUEUE", "queue": "leximon-analytics" }],
    "consumers": [
      {
        "queue": "leximon-analytics",
        "max_batch_size": 100,
        "max_batch_timeout": 10,
        "max_retries": 5
      }
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder until the production Hyperdrive config is created (D-005).
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://leximon:leximon@127.0.0.1:54329/leximon"
    }
  ]
}
