{
  "expo": {
    "name": "Leximon",
    "slug": "leximon",
    "owner": "raphplt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leximon",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "fr.leximon.app",
      "appStoreUrl": "https://apps.apple.com/app/id6827744020",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:leximon.fr"],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.leximon.app",
      "adaptiveIcon": {
        "backgroundColor": "#1C0F07",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "leximon.fr", "pathPrefix": "/ami" },
            { "scheme": "https", "host": "leximon.fr", "pathPrefix": "/invitation" },
            { "scheme": "https", "host": "leximon.fr", "pathPrefix": "/carte" },
            { "scheme": "https", "host": "leximon.fr", "pathPrefix": "/joueur" },
            { "scheme": "https", "host": "leximon.fr", "pathPrefix": "/enigme" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=fr.leximon.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BricolageGrotesque-Medium.ttf",
            "./assets/fonts/BricolageGrotesque-SemiBold.ttf",
            "./assets/fonts/BricolageGrotesque-Bold.ttf",
            "./assets/fonts/BricolageGrotesque-ExtraBold.ttf",
            "./assets/fonts/Fraunces-Black.ttf",
            "./assets/fonts/Fraunces-ExtraBold.ttf",
            "./assets/fonts/Newsreader-Regular.ttf",
            "./assets/fonts/Newsreader-Medium.ttf",
            "./assets/fonts/Newsreader-Italic.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C0F07",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Leximon suit l'inclinaison du téléphone pour faire jouer la lumière sur les cartes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e6c7ad61-577e-4c31-965c-aeeea542e60e"
      }
    },
    "backgroundColor": "#1C0F07"
  }
}
