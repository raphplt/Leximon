{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@leximon/api", "dev"],
      "port": 8787
    },
    {
      "name": "api-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@leximon/api",
        "exec",
        "wrangler",
        "dev",
        "--test-scheduled",
        "--var",
        "TRUSTED_ORIGINS:http://localhost:3100",
        "--var",
        "PUBLIC_WEB_URL:http://localhost:3100"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@leximon/web", "dev"],
      "port": 3000
    },
    {
      "name": "web-start",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@leximon/web", "exec", "next", "start", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@leximon/mobile",
        "exec",
        "expo",
        "start",
        "--dev-client",
        "--localhost"
      ],
      "port": 8081
    },
    {
      "name": "da-jeu",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "rnd/da-jeu"
      ],
      "port": 4173
    }
  ]
}
